# External development computer only. Do not place this file under application/.
export ROBOT_PROJECT_ROOT="$HOME/Robot_Arm_Project"

# Wired network: change to the actual IPs assigned to the vehicle and this PC.
export VEHICLE_IP="192.168.2.10"
export LOCAL_VISION_IP="192.168.2.20"
export MASTER_NODE_HTTP_PORT="1819"

# Safety defaults. The visual executor still starts disabled even if this says true.
export VISION_DRY_RUN="true"
export ROS_DOMAIN_ID="0"
