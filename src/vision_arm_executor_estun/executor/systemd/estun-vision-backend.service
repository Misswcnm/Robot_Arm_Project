[Unit]
Description=ESTUN vision arm backend (ROS 2 Foxy)
Wants=network-online.target
After=network-online.target
Conflicts=robot-arm.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=nvidia
Group=nvidia
WorkingDirectory=/home/nvidia/Robot_Arm_Project
Environment=HOME=/home/nvidia
Environment=ROBOT_ARM_WORKSPACE=/home/nvidia/Robot_Arm_Project
Environment=PYTHONNOUSERSITE=1
ExecStart=/home/nvidia/Robot_Arm_Project/install/vision_arm_executor_estun/lib/vision_arm_executor_estun/start_estun_vision_backend.sh
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
KillMode=control-group
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
