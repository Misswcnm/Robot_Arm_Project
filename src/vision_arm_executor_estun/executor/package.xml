<?xml version="1.0"?>
<package format="3">
  <name>vision_arm_executor_estun</name>
  <version>0.1.0</version>
  <description>ESTUN robot adapter for the existing vision_arm_executor protocol.</description>
  <maintainer email="ylx@example.com">ylx</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>apriltag_pick</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>estun_codroid_bridge</exec_depend>
  <exec_depend>icp_servoing</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>vision_arm_executor</exec_depend>

  <test_depend>ament_pytest</test_depend>
