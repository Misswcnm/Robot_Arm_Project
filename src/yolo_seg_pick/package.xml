<?xml version="1.0"?>
<package format="3">
  <name>yolo_seg_pick</name>
  <version>0.1.0</version>
  <description>Guarded YOLO11-seg RGB-D pick demo for D455 and Dobot CR5.</description>
  <maintainer email="ylx@example.com">ylx</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>dobot_msgs_v4</exec_depend>
  <exec_depend>step_motor</exec_depend>
  <exec_depend>apriltag_pick</exec_depend>
  <exec_depend>realsense2_camera</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
