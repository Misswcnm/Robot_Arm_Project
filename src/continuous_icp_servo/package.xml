<?xml version="1.0"?>
<package format="3">
  <name>continuous_icp_servo</name>
  <version>0.1.0</version>
  <description>Continuous ICP visual servoing with low-rate ICP and high-rate ServoP commands.</description>
  <maintainer email="ylx@example.com">ylx</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>dobot_msgs_v4</depend>

  <build_depend>eigen</build_depend>
  <exec_depend>eigen</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
