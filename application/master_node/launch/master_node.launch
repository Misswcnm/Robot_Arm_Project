<?xml version="1.0"?>
<launch>
    <!-- 设置机械臂类型环境变量 -->
    <env name="DOBOT_TYPE" value="cr3" />
    
    <!-- 设置ROS环境变量 -->
    <env name="ROS_DISTRO" value="noetic" />
    
    <!-- 启动master_node -->
    <node pkg="master_node" type="master_node" respawn="false" name="master_node" output="screen">
        <!-- 可以在这里添加其他参数 -->
    </node>
    
    <!-- MechanicalArmController is constructed by MasterNodeSubscriber.
         Do not launch mechanical_arm_controller.py separately: it is a library
         module, not an executable ROS node. -->
</launch>
